    "source_code": "#include <cuda_runtime.h>\nextern \"C\" __global__ void vec_add(const float* a, const float* b, float* c, int n) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx < n) { c[idx] = a[idx] + b[idx]; }\n}\n",
