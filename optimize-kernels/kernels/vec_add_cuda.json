          }
        },
        { "name": "n", "type": "int", "role": "input", "value": 1024 }
      ],
      "launch": {
        "grid": { "x": 4, "y": 1, "z": 1 },
        "block": { "x": 256, "y": 1, "z": 1 }
      }
