          "role": "input",
          "tensor_spec": {
            "shape": [1024],
            "dtype": "float32",
            "init": { "kind": "randn", "seed": 2 }
          }
        },
        {
          "name": "c",
          "type": "tensor",
          "role": "output",
          "tensor_spec": {
            "shape": [1024],
